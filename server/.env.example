PORT=8787

# Add a key for at least one provider. All three have free tiers, no credit card needed.

# Groq — https://console.groq.com/keys
AFT_GQ_TOKEN=

# Google Gemini — https://aistudio.google.com/apikey
AFT_GM_TOKEN=

# OpenRouter — https://openrouter.ai/settings/keys
AFT_OR_TOKEN=

# Optional model overrides (defaults shown)
# AFT_GQ_MODEL=openai/gpt-oss-120b
# AFT_GM_MODEL=gemini-flash-latest
# AFT_OR_MODEL=openrouter/free

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Max API requests per visitor IP per minute (protects your free quotas once deployed)
# AFT_RATE_LIMIT=20
